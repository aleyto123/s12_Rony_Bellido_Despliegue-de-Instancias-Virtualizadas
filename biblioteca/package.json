{
  "name": "biblioteca-s12",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "node scripts/check-api.mjs",
    "db:check": "node --env-file=.env scripts/check-db.mjs",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "format": "prettier --write app components lib prisma/seed.ts tests scripts docs *.json *.md",
    "format:check": "prettier --check app components lib prisma/seed.ts tests scripts docs *.json *.md",
    "test:production": "node scripts/test-production.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
