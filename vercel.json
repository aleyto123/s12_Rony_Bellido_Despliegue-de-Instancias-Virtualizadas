{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "biblioteca": {
      "root": "biblioteca",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "biblioteca" }
    }
  ]
}
